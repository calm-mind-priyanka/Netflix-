# ==========================================
# MongoDB (READ-ONLY media source)
# ==========================================
DATABASE_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
DATABASE_URI2=mongodb+srv://USERNAME:PASSWORD@SECONDARY_CLUSTER/DATABASE
DATABASE_NAME=Cluster0
COLLECTION_NAME=Sandy_files
MULTIPLE_DB=true

# ==========================================
# Telegram / exact file_id playback
# ==========================================
BOT_TOKEN=
API_ID=0
API_HASH=
MOVIE_SITE_SESSION=movie_site

# ==========================================
# Website security
# ==========================================
SITE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
PUBLIC_URL=https://your-domain.koyeb.app

# ==========================================
# Admin
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ==========================================
# External metadata
# ==========================================
TMDB_API_KEY=

# ==========================================
# Server / Koyeb
# ==========================================
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ==========================================
# Catalog / search
# ==========================================
CATALOG_TTL=60
CATALOG_MAX_DOCS=300
SEARCH_MAX_DOCS=1500
SEARCH_CANDIDATE_LIMIT=120
USE_CAPTION_FILTER=true

# ==========================================
# Streaming
# ==========================================
STREAM_TOKEN_TTL=300
STREAM_CHUNK_TIMEOUT=45
STREAM_CONCURRENCY=4
TRANSCODE_CONCURRENCY=1

# ==========================================
# Metadata cache
# ==========================================
TMDB_CACHE_MAX=128

# ==========================================
# Website MongoDB collections
# ==========================================
WEBSITE_SETTINGS_COLLECTION=vyra_settings
WEBSITE_CATALOG_COLLECTION=vyra_catalog_index

# ==========================================
# Premium / payments
# ==========================================
# manual = manual/admin approval
# razorpay = automatic payment
# both = both methods
PAYMENT_PROVIDER=both

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Format:
# plan_id|display name|price INR,...
PREMIUM_PLANS=7day|7 Days|29,15day|15 Days|49,30day|30 Days|79,60day|60 Days|129

# ==========================================
# Manual payment
# ==========================================
MANUAL_PAYMENT_INSTRUCTIONS=Pay using your configured payment method, then upload the payment screenshot for admin approval.
MANUAL_PAYMENT_QR=

# ==========================================
# Premium / verification MongoDB collections
# ==========================================
WEBSITE_PREMIUM_USERS_COLLECTION=vyra_premium_users
WEBSITE_PREMIUM_ORDERS_COLLECTION=vyra_premium_orders
WEBSITE_PREMIUM_MANUAL_COLLECTION=vyra_premium_manual
WEBSITE_VERIFY_COLLECTION=vyra_verification_tokens

# ==========================================
# Website account / payment ledger collections
# ==========================================
WEBSITE_USERS_COLLECTION=vyra_users
WEBSITE_PAYMENTS_COLLECTION=vyra_payments
WEBSITE_HISTORY_COLLECTION=vyra_user_history

# MANUAL_PAYMENT_INSTRUCTIONS / MANUAL_PAYMENT_QR are legacy fallback values.
# Prefer the Admin Panel -> Premium & Payments MongoDB settings for permanent
# UPI ID, QR and instructions. Keep secrets out of the frontend.
