# ==========================================
# MongoDB (READ-ONLY media source)
# ==========================================
DATABASE_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
DATABASE_URI2=mongodb+srv://USERNAME:PASSWORD@SECONDARY_CLUSTER/DATABASE
DATABASE_NAME=Cluster0
COLLECTION_NAME=Sandy_files
MULTIPLE_DB=true

# ==========================================
# Telegram / exact file_id playback
# ==========================================
BOT_TOKEN=
API_ID=0
API_HASH=
MOVIE_SITE_SESSION=movie_site

# ==========================================
# Website security
# ==========================================
SITE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
PUBLIC_URL=https://your-domain.koyeb.app

# ==========================================
# Admin
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ==========================================
# External metadata / poster fallback
# ==========================================
TMDB_API_KEY=

# ==========================================
# Server / Koyeb
# ==========================================
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ==========================================
# Catalog / search safety limits
# ==========================================
CATALOG_TTL=60
CATALOG_MAX_DOCS=300
SEARCH_MAX_DOCS=1500
SEARCH_CANDIDATE_LIMIT=120
USE_CAPTION_FILTER=true

# ==========================================
# Streaming
# ==========================================
STREAM_TOKEN_TTL=300
STREAM_CHUNK_TIMEOUT=45
STREAM_CONCURRENCY=4
TRANSCODE_CONCURRENCY=1

# ==========================================
# Metadata cache
# ==========================================
TMDB_CACHE_MAX=128

# ==========================================
# Website admin-settings storage
# NOTE: /tmp is ephemeral on Koyeb. Do not use it for data that must
# survive instance replacement/redeploy. AutoFilter media MongoDB is
# never used as the website settings store.
# ==========================================
WEBSITE_SETTINGS_FILE=/tmp/streambox_settings.json

# ==========================================
# Premium / payments
# ==========================================
# manual  = admin approval
# razorpay = automatic payment verification
# both    = offer both methods
PAYMENT_PROVIDER=both

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Legacy/default single-plan values (used only where applicable)
PREMIUM_PRICE_INR=99
PREMIUM_DAYS=30

# Premium plan format:
# plan_id|display name|price INR,plan_id|display name|price INR,...
PREMIUM_PLANS=7day|7 Days|29,15day|15 Days|49,30day|30 Days|79,60day|60 Days|129

# Separate from the read-only AutoFilter media database.
PREMIUM_STORE_FILE=/tmp/streambox_premium.json

# Manual payment flow
MANUAL_PAYMENT_INSTRUCTIONS=Pay using your configured payment method, then upload the payment screenshot for admin approval.
MANUAL_PAYMENT_QR=
PREMIUM_PROOF_DIR=/tmp/streambox_premium_proofs


# Website-side MongoDB collections (separate from the read-only AutoFilter media collection)
WEBSITE_PREMIUM_USERS_COLLECTION=streambox_premium_users
WEBSITE_PREMIUM_ORDERS_COLLECTION=streambox_premium_orders
WEBSITE_PREMIUM_MANUAL_COLLECTION=streambox_premium_manual
WEBSITE_VERIFY_COLLECTION=streambox_verification_tokens
