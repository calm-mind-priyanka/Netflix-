# ============================================================
# DATABASE / TELEGRAM SOURCE
# ============================================================

DATABASE_URI=
DATABASE_URI2=
DATABASE_NAME=Cluster0
COLLECTION_NAME=Sandy_files
MULTIPLE_DB=true

BOT_TOKEN=
API_ID=0
API_HASH=
MOVIE_SITE_SESSION=movie_site


# ============================================================
# WEBSITE / SECURITY
# ============================================================

SITE_SECRET=
PUBLIC_URL=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=


# ============================================================
# TMDB / EXTERNAL METADATA
# ============================================================

TMDB_API_KEY=


# ============================================================
# SERVER
# ============================================================

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO


# ============================================================
# CATALOG / SEARCH
# ============================================================

CATALOG_TTL=60
CATALOG_MAX_DOCS=300

# Maximum MongoDB documents considered for broader catalog/search
# operations.
SEARCH_MAX_DOCS=1500

# Initial bounded candidate count for normal search.
SEARCH_CANDIDATE_LIMIT=120

# Use Mongo caption filtering where supported.
USE_CAPTION_FILTER=true


# ============================================================
# STREAMING
# ============================================================

STREAM_TOKEN_TTL=300
STREAM_CHUNK_TIMEOUT=45
STREAM_CONCURRENCY=4
TRANSCODE_CONCURRENCY=1


# ============================================================
# TMDB CACHE
# ============================================================

TMDB_CACHE_MAX=128


# ============================================================
# WEBSITE SETTINGS STORAGE
# ============================================================

# Runtime website/admin settings.
# /tmp is ephemeral on Koyeb; use persistent storage/database
# if these settings must survive redeploys/restarts.
WEBSITE_SETTINGS_FILE=/tmp/streambox_settings.json


# ============================================================
# PREMIUM / PAYMENT
# ============================================================

# Supported values can include:
# manual
# razorpay
# both
PAYMENT_PROVIDER=manual

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PREMIUM_PRICE_INR=99
PREMIUM_DAYS=30

# Multiple premium plans:
# format:
# plan_id|display_name|price
PREMIUM_PLANS=7day|7 Days|29,15day|15 Days|49,30day|30 Days|79,60day|60 Days|129


# ============================================================
# PREMIUM STORAGE
# ============================================================

# Runtime premium/subscription data.
# /tmp is ephemeral on Koyeb. For production, use persistent
# website-side storage/database.
PREMIUM_STORE_FILE=/tmp/streambox_premium.json

# Manual payment instructions shown to users.
MANUAL_PAYMENT_INSTRUCTIONS=Pay using the payment method shown by the administrator, then upload your payment screenshot for approval.

# Optional QR image/path used by the manual payment flow.
MANUAL_PAYMENT_QR=

# Directory for uploaded manual-payment proof screenshots.
PREMIUM_PROOF_DIR=/tmp/streambox_premium_proofs
