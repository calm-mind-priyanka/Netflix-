# ==========================================
# Netflix Website / Auto Filter Configuration
# ==========================================

# MongoDB - Primary database
DATABASE_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE

# MongoDB - Secondary database
# Required when MULTIPLE_DB=true
DATABASE_URI2=mongodb+srv://USERNAME:PASSWORD@SECONDARY_CLUSTER/DATABASE

# MongoDB database and collection
DATABASE_NAME=Cluster0
COLLECTION_NAME=Sandy_files

# Use both DATABASE_URI and DATABASE_URI2
MULTIPLE_DB=true


# ==========================================
# Telegram
# ==========================================

BOT_TOKEN=
API_ID=0
API_HASH=


# ==========================================
# Website
# ==========================================

MOVIE_SITE_SESSION=movie_site

SITE_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

PUBLIC_URL=https://your-domain.com


# ==========================================
# TMDB
# ==========================================

TMDB_API_KEY=


# ==========================================
# Admin
# ==========================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=


# ==========================================
# Catalog
# ==========================================

CATALOG_TTL=60

CATALOG_MAX_DOCS=300

# Safe search limit for Koyeb Free
SEARCH_MAX_DOCS=1500

# Search both filename and caption
USE_CAPTION_FILTER=true


# ==========================================
# Server
# ==========================================

HOST=0.0.0.0
PORT=8080


# ==========================================
# Streaming
# ==========================================

STREAM_TOKEN_TTL=300


# ==========================================
# TMDB Cache
# ==========================================

TMDB_CACHE_MAX=128


# ==========================================
# Transcoding
# ==========================================

TRANSCODE_CONCURRENCY=1
