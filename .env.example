# ==========================================
# NETFLIX WEBSITE CONFIGURATION
# ==========================================

# ==========================================
# MONGODB
# ==========================================

# Main MongoDB
DATABASE_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE

# Optional second database
DATABASE_URI2=

# Database name
DATABASE_NAME=Cluster0

# Main collection
COLLECTION_NAME=Sandy_files

# true = use DATABASE_URI2
# false = use only DATABASE_URI
MULTIPLE_DB=false


# ==========================================
# TELEGRAM
# ==========================================

BOT_TOKEN=
API_ID=
API_HASH=


# ==========================================
# WEBSITE
# ==========================================

MOVIE_SITE_SESSION=movie_site

# Change to a long random secret
SITE_SECRET=

# Public domain
PUBLIC_URL=


# ==========================================
# ADMIN
# ==========================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=


# ==========================================
# TMDB
# ==========================================

# Optional but recommended
# Used for:
# - Posters
# - Backdrops
# - Metadata fallback
TMDB_API_KEY=

# TMDB cache size
TMDB_CACHE_MAX=128


# ==========================================
# CATALOG
# ==========================================

# Cache lifetime
CATALOG_TTL=60

# Homepage document limit
CATALOG_MAX_DOCS=300

# IMPORTANT
# Search limit increased from old limit
SEARCH_MAX_DOCS=10000


# ==========================================
# SEARCH
# ==========================================

# Search filename + caption
USE_CAPTION_FILTER=true


# ==========================================
# STREAMING
# ==========================================

STREAM_TOKEN_TTL=300


# ==========================================
# SERVER
# ==========================================

HOST=0.0.0.0
PORT=8080


# ==========================================
# TRANSCODING
# ==========================================

TRANSCODE_CONCURRENCY=1
